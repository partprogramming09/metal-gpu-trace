      "bytes": 9291979,
      "dir": "drawstress",
      "dim_variable": "DRAWSTRESS_DIM",
      "size_variables": ["DRAWSTRESS_WIDTH", "DRAWSTRESS_HEIGHT"],
      "apis": {
        "mtl": {"program": "drawstress", "args": "--mtl", "wine": false},
        "mtl-x64": {"program": "drawstress-x64", "args": "--mtl", "wine": false, "rosetta": true},
        "vk": {"program": "drawstress", "args": "--vk", "wine": false, "moltenvk": true},
        "d3d11": {"program": "drawstress.exe", "args": "--d3d11", "wine": true},
        "d3d12": {"program": "drawstress.exe", "args": "--d3d12", "wine": true}
      }
    },
    "bgfx-examples": {
      "title": "bgfx examples",
      "about": "Thirty of bgfx's examples, each a different load (the last twenty-one only measured in native Metal; 26-occlusion, 37-gpudrivenrendering, 41-tess and 45-bokeh do not wait for the display, 700 to 3900 FPS, so compare their GPU ms with paced runs with care; 41-tess holds 3.2 GiB of Metal memory; 39-assao takes about 6 ms of GPU per frame; also 05-instancing, 22-windows, 27-terrain, 33-pom, 50-headless and 51-gpufont): 01-cubes and 35-dynamic (many cubes, uploads), 06-bump (textured), 09-hdr (render-target chain), 21-deferred (G-buffer and lights), 24-nbody (compute), 31-rsm (reflective shadow maps), 38-bloom (post-processing), 48-drawindirect (draws the GPU decides); and, run only in native Metal so far, 08-update (texture uploads in every compressed format), 10-font and 20-nanovg (text and interface), 16-shadowmaps, 19-oit and 32-particles (transparency and overdraw), 30-picking (GPU read-back), 40-svt (sparse virtual textures: its first run writes a 370 MB tile cache to temp/ in the workload's folder), 46-fsr (upscaling), 47-pixelformats (texture formats). Pass example to perf_record.",
