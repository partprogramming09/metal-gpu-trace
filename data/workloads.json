{
  "about": "Test programs that workload_fetch downloads. Each is built from source by .github/workflows/workloads.yml; its BUILD.txt lists the commits.",
  "workloads": {
    "drawstress": {
      "title": "bgfx 17-drawstress",
      "about": "Draws a grid of cubes, dim^3 draw calls per frame (64 000 at dim 40): measures what one draw costs in native Metal and through a translation layer. Shaders are inside the program.",
      "license": "BSD-2-Clause (bgfx, Branimir Karadzic); LICENSE-bgfx in the archive",
      "url": "https://github.com/partprogramming09/metal-gpu-trace/releases/download/workloads-3/drawstress-workloads-3.tar.gz",
      "sha256": "2b3b01fa2dd0a7d5a1629046305319130d58ce4d843bd22c3f736071c0bfde2e",
      "bytes": 9291979,
      "dir": "drawstress",
      "dim_variable": "DRAWSTRESS_DIM",
      "size_variables": ["DRAWSTRESS_WIDTH", "DRAWSTRESS_HEIGHT"],
      "apis": {
        "mtl": {"program": "drawstress", "args": "--mtl", "wine": false},
        "mtl-x64": {"program": "drawstress-x64", "args": "--mtl", "wine": false, "rosetta": true},
        "vk": {"program": "drawstress", "args": "--vk", "wine": false, "moltenvk": true},
        "d3d11": {"program": "drawstress.exe", "args": "--d3d11", "wine": true},
        "d3d12": {"program": "drawstress.exe", "args": "--d3d12", "wine": true}
      }
    },
    "bgfx-examples": {
      "title": "bgfx examples",
      "about": "Nineteen of bgfx's examples, each a different load: 01-cubes and 35-dynamic (many cubes, uploads), 06-bump (textured), 09-hdr (render-target chain), 21-deferred (G-buffer and lights), 24-nbody (compute), 31-rsm (reflective shadow maps), 38-bloom (post-processing), 48-drawindirect (draws the GPU decides); and, run only in native Metal so far, 08-update (texture uploads in every compressed format), 10-font and 20-nanovg (text and interface), 16-shadowmaps, 19-oit and 32-particles (transparency and overdraw), 30-picking (GPU read-back), 40-svt (sparse virtual textures: its first run writes a 370 MB tile cache to temp/ in the workload's folder), 46-fsr (upscaling), 47-pixelformats (texture formats). Pass example to perf_record.",
      "license": "BSD-2-Clause (bgfx, Branimir Karadzic); LICENSE-bgfx in the archive",
      "url": "https://github.com/partprogramming09/metal-gpu-trace/releases/download/workloads-6/bgfx-examples-workloads-6.tar.gz",
      "sha256": "c5b25350c15ea7b32a497b3b8c6277f5d29df6d798812d1abdeb215cff1cf99a",
      "bytes": 38077604,
      "dir": "bgfx-examples",
      "examples": {
        "01-cubes": "01-", "06-bump": "06-", "09-hdr": "09-", "21-deferred": "21-", "24-nbody": "24-",
        "31-rsm": "31-", "35-dynamic": "35-", "38-bloom": "38-", "48-drawindirect": "48-",
        "08-update": "08-", "10-font": "10-", "16-shadowmaps": "16-", "19-oit": "19-", "20-nanovg": "20-",
        "30-picking": "30-", "32-particles": "32-", "40-svt": "40-", "46-fsr": "46-", "47-pixelformats": "47-"
      },
      "example_traits": {
        "01-cubes": {"class": "cpu_submit", "native_encoders_per_frame": 2},
        "06-bump": {"class": "textured", "native_encoders_per_frame": 2},
        "09-hdr": {"class": "postprocess", "native_encoders_per_frame": 11},
        "21-deferred": {"class": "gpu_bandwidth", "native_encoders_per_frame": 5},
        "24-nbody": {"class": "compute", "native_encoders_per_frame": 3},
        "31-rsm": {"class": "gpu_alu", "native_encoders_per_frame": 5},
        "35-dynamic": {"class": "streaming", "native_encoders_per_frame": 2},
        "38-bloom": {"class": "postprocess", "native_encoders_per_frame": 11},
        "48-drawindirect": {"class": "indirect", "native_encoders_per_frame": 3},
        "08-update": {"class": "streaming", "native_encoders_per_frame": 14},
        "10-font": {"class": "ui_text", "native_encoders_per_frame": 2},
        "16-shadowmaps": {"class": "shadows", "native_encoders_per_frame": 4},
        "19-oit": {"class": "overdraw", "native_encoders_per_frame": 3},
        "20-nanovg": {"class": "ui_text", "native_encoders_per_frame": 2},
        "30-picking": {"class": "readback", "native_encoders_per_frame": 4},
        "32-particles": {"class": "overdraw", "native_encoders_per_frame": 2},
        "40-svt": {"class": "streaming", "native_encoders_per_frame": 5},
        "46-fsr": {"class": "upscale", "native_encoders_per_frame": 5},
        "47-pixelformats": {"class": "format_coverage", "native_encoders_per_frame": 2}
      },
      "apis": {
        "mtl": {"program": "examples", "args": "--mtl", "wine": false},
        "d3d11": {"program": "examples.exe", "args": "--d3d11", "wine": true},
        "d3d12": {"program": "examples.exe", "args": "--d3d12", "wine": true}
      }
    }
  }
}
