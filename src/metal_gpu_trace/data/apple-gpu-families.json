    },
    "Apple8": {
      "mac_chips": ["M2 series"],
      "other_chips": ["A15", "A16"],
      "adds": ["lossy texture compression", "SIMD shift and fill", "sparse depth/stencil on every device",
               "placement sparse on every device", "query texture LOD on every device",
               "64-bit atomic min/max on ulong in buffers and textures, macOS only"],
      "limits": {"mesh_grid_threadgroups": 1024, "argument_buffer_samplers_per_stage": 996,
                 "mesh_payload_and_geometry_per_draw": "up to 4 GB", "texture_2d_px": 16384}
    },
    "Apple9": {
      "mac_chips": ["M3 series", "M4 series"],
      "other_chips": ["A17 Pro", "A18"],
      "adds": ["full 64-bit atomics", "BC pixel formats on every device", "mesh draws in indirect command buffers",
               "indirect mesh draw arguments", "ICB memory barriers for rendering",
               "row-major matrices in acceleration structures", "per-component motion in ray tracing",
               "MetalFX denoised upscaling", "Dynamic Caching (registers allocated as the program runs)"],
      "limits": {"mesh_grid_threadgroups": 1048575, "argument_buffer_samplers_per_stage": 500000,
