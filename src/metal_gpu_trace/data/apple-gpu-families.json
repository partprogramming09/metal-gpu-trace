    },
    "Apple10": {
      "mac_chips": ["M5 series"],
      "other_chips": ["A19"],
      "adds": ["depth bounds testing", "sampler min/max reduction", "sampler LOD bias",
               "pre-raster per-vertex values", "ICB raster and depth/stencil state", "atomics on cube map textures",
               "universal texture compression", "32 768 px textures", "16x16 tiles with 8x MSAA"],
      "limits": {"mesh_grid_threadgroups": 4194303, "argument_buffer_samplers_per_stage": 500000,
