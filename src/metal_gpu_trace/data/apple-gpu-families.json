{
  "about": "Apple silicon GPU families Apple7 to Apple10: chips, first family with each feature, and limits that differ. Facts restated from Apple's public documents, not Apple's text. Check a device with MTLDevice.supportsFamily; families nest, so an Apple9 GPU also supports Apple7 and Apple8.",
  "sources": {
    "families": "https://developer.apple.com/documentation/metal/mtlgpufamily",
    "feature_set_tables": "https://developer.apple.com/metal/Metal-Feature-Set-Tables.pdf",
    "feature_set_tables_date": "2026-05-21",
    "m3_tech_talk": "https://developer.apple.com/videos/play/tech-talks/111375/"
  },
  "guards": {
    "M1 only": "Apple7 && !Apple8",
    "before M3": "!Apple9"
  },
  "families": {
    "Apple7": {
      "mac_chips": ["M1", "M1 Pro", "M1 Max", "M1 Ultra"],
      "other_chips": ["A14"],
      "adds": ["mesh shading", "SIMD-scoped and quad-scoped reductions", "SIMD-scoped matrix multiply",
               "floating-point atomics", "primitive ID", "barycentric coordinates", "border color",
               "layered rendering to multisample textures", "MetalFX temporal upscaling",
               "acquire/release memory ordering atomics", "Metal 4"],
      "limits": {"mesh_grid_threadgroups": 1024, "argument_buffer_samplers_per_stage": 996,
